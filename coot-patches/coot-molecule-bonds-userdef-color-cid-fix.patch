 #define GLM_ENABLE_EXPERIMENTAL
 #include <glm/glm.hpp>
@@ -148,28 +152,168 @@ coot::molecule_t::apply_user_defined_atom_colour_selections(const std::vector<st
             int colour_index = rc.second; // change type
             int selHnd = mol->NewSelection(); // d
 
